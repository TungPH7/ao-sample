{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quality/gates.yaml",
  "description": "Quality gates of a project (quality-gates spec sections 2.2 to 2.8 and 6).",
  "type": "object",
  "required": ["checks", "coverage", "dependencies", "suppressions", "protected_branches", "merge_method", "protected_paths", "docs_pull_requests", "github_apps"],
  "additionalProperties": false,
  "properties": {
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "coverage": {
      "type": "object",
      "required": ["changed_lines_min", "lcov", "source", "exclude"],
      "additionalProperties": false,
      "properties": {
        "changed_lines_min": { "type": "number", "minimum": 0, "maximum": 100 },
        "lcov": { "$ref": "#/$defs/globs" },
        "source": { "$ref": "#/$defs/globs" },
        "exclude": { "type": "array", "items": { "$ref": "#/$defs/text" } }
      }
    },
    "dependencies": {
      "type": "object",
      "required": ["audit_level", "exceptions"],
      "additionalProperties": false,
      "properties": {
        "audit_level": { "enum": ["low", "moderate", "high", "critical"] },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["advisory", "reason", "expires"],
            "additionalProperties": false,
            "properties": {
              "advisory": { "type": "string", "pattern": "^GHSA(-[23456789cfghjmpqrvwx]{4}){3}$" },
              "reason": { "$ref": "#/$defs/text" },
              "expires": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
          }
        }
      }
    },
    "suppressions": {
      "type": "object",
      "required": ["reason_marker", "patterns", "never"],
      "additionalProperties": false,
      "properties": {
        "reason_marker": { "$ref": "#/$defs/text" },
        "patterns": { "$ref": "#/$defs/texts" },
        "never": { "$ref": "#/$defs/texts" }
      }
    },
    "protected_branches": { "$ref": "#/$defs/texts" },
    "merge_method": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "enum": ["squash", "merge"] }
    },
    "protected_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "path": { "$ref": "#/$defs/text" },
          "editors": { "$ref": "#/$defs/roles" }
        }
      }
    },
    "docs_pull_requests": {
      "type": "object",
      "required": ["paths", "branch", "gate"],
      "additionalProperties": false,
      "properties": {
        "paths": { "$ref": "#/$defs/globs" },
        "branch": { "type": "string", "pattern": "^[a-z]+/[A-Za-z0-9._-]*<EPIC>[A-Za-z0-9._-]*$" },
        "gate": { "$ref": "#/$defs/id" }
      }
    },
    "github_apps": {
      "type": "object",
      "required": ["dev", "review"],
      "additionalProperties": false,
      "properties": {
        "dev": { "$ref": "#/$defs/app" },
        "review": { "$ref": "#/$defs/app" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "text": { "type": "string", "minLength": 1 },
    "texts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "globs": { "$ref": "#/$defs/texts" },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "app": {
      "type": "object",
      "required": ["env", "roles", "commands"],
      "additionalProperties": false,
      "properties": {
        "env": { "type": "string", "pattern": "^AO_[A-Z]+_APP$" },
        "roles": { "$ref": "#/$defs/roles" },
        "commands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["create", "edit", "comment", "review"] }
        }
      }
    }
  }
}
