{
  "name": "ao-sample",
  "version": "0.1.0",
  "private": true,
  "description": "Sample Next.js + NestJS app for Pilot 1 of ai-orchestrator",
  "engines": {
    "node": ">=24.2"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test:coverage": "npm run test:coverage --workspaces",
    "build": "npm run build --workspaces",
    "test:e2e": "playwright test",
    "prepare": "node .ai-orchestrator/scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
